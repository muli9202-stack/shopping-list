{
  "name": "shopping-list",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "build:artifact": "vite build -c kitchen/vite.artifact.config.ts && node kitchen/scripts/build-artifact.mjs",
    "chavruta:test": "vitest run -c chavruta/vitest.config.ts",
    "chavruta:live": "LIVE=1 vitest run -c chavruta/vitest.config.ts chavruta/tests/unit/live.test.ts",
    "chavruta:e2e": "npm run build && cd chavruta && playwright test",
    "chavruta:snapshot": "node chavruta/scripts/build-snapshot.mjs",
    "chavruta:coverage": "node --experimental-strip-types chavruta/scripts/check-coverage.mts",
    "chavruta:artifact": "vite build -c chavruta/vite.artifact.config.ts && node chavruta/scripts/build-artifact.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@fontsource/frank-ruhl-libre": "^5.3.0",
    "@fontsource/heebo": "^5.3.0",
    "@zxing/browser": "^0.2.1",
    "@zxing/library": "^0.23.0",
    "fflate": "^0.8.3",
    "firebase": "^12.19.0",
    "idb-keyval": "^6.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "three": "^0.186.1",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.3"
  }
}
